# Copy to .env and fill in. Every variable maps to a field in app/config.py.

# ---- LLM ---------------------------------------------------------------
# gemini (default) | openai (any OpenAI-compatible endpoint, incl. Ollama) | fake (offline demo)
LLM_PROVIDER=gemini
GEMINI_API_KEY=your-gemini-api-key          # https://aistudio.google.com/apikey (free tier works)
GEMINI_SQL_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.5-flash-lite
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBEDDING_DIM=768

# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1   # Ollama: http://localhost:11434/v1
# OPENAI_SQL_MODEL=gpt-4.1-mini
# OPENAI_FAST_MODEL=gpt-4.1-nano
# OPENAI_EMBED_MODEL=text-embedding-3-small

# ---- Database ------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://copilot_user:dev_password@localhost:5432/eando_copilot
# Least-privilege role used to execute LLM-generated SQL (created by db/schema.sql)
READONLY_DATABASE_URL=postgresql+psycopg2://copilot_readonly:readonly_password@localhost:5432/eando_copilot
SQL_STATEMENT_TIMEOUT_MS=8000
SQL_MAX_ROWS=1000

# ---- RAG -------------------------------------------------------------------
KB_VERSION=v2
CHROMA_DIR=.chroma
CACHE_DIR=.cache/rag
RETRIEVAL_TOP_K=12
CONTEXT_TOP_N=6
USE_RERANK=true
USE_QUERY_REWRITE=true
USE_SEMANTIC_CACHE=true
SEMANTIC_CACHE_THRESHOLD=0.95

# ---- Agent loop ------------------------------------------------------------
MAX_REPAIR_ATTEMPTS=2
SUMMARIZE_RESULTS=true
PROMPT_VERSION=sql-v3

# ---- API security ------------------------------------------------------------
API_KEYS=                       # comma-separated; empty disables auth (local dev)
RATE_LIMIT_PER_MINUTE=60
CORS_ORIGINS=*

# ---- Observability ---------------------------------------------------------------
AUDIT_LOG_DIR=.logs
LOG_LEVEL=INFO
